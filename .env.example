# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/ecommerce

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the app (1 on Render/Heroku, 0 locally)
TRUST_PROXY=0

LOG_LEVEL=info

# Razorpay — Dashboard > Account & Settings > API Keys (use rzp_test_ keys outside production)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-key-secret
# Dashboard > Webhooks: URL https://<your-api>/api/webhooks/razorpay, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Stripe (optional) — Dashboard > Developers > API keys (use sk_test_ keys outside production).
# Webhook: Dashboard > Developers > Webhooks > Add endpoint, URL https://<your-api>/api/stripe/webhook,
# events checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, refund.updated, charge.dispute.created.
# Locally: `stripe listen --forward-to localhost:5000/api/stripe/webhook` prints the whsec_ value.
# Set both or neither; without them the Stripe payment option is hidden.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Unpaid online orders are cancelled and their stock released after this many minutes
ORDER_PAYMENT_WINDOW_MINUTES=30

# Optional: secret for GET /api/cron/expire-orders, which cancels unpaid orders and expires memberships.
# The server's own timer does this when it runs as a normal process. On Vercel (free plan has no cron)
# leave this empty to keep the endpoint off, or set 16+ random characters and call it from a free
# external scheduler (e.g. cron-job.org) with the header `Authorization: Bearer <CRON_SECRET>`.
# On Vercel also set TRUST_PROXY=1 and add every variable above in Project Settings > Environment Variables.
CRON_SECRET=some-random-secret-of-at-least-16-chars

# Email (password reset, order and Plus emails) — https://resend.com > API Keys.
# Leave RESEND_API_KEY empty in development: emails are then printed in the server log.
# EMAIL_FROM must use a domain verified in Resend (onboarding@resend.dev only sends to your own address).
RESEND_API_KEY=
EMAIL_FROM=WebMart <onboarding@resend.dev>
# Storefront URL used in email links; defaults to the first CORS_ORIGINS entry.
CLIENT_URL=
