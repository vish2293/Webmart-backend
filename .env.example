# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/ecommerce

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the app (1 on Render/Heroku, 0 locally)
TRUST_PROXY=0

LOG_LEVEL=info

# Razorpay — Dashboard > Account & Settings > API Keys (use rzp_test_ keys outside production)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-key-secret
# Dashboard > Webhooks: URL https://<your-api>/api/webhooks/razorpay, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Unpaid online orders are cancelled and their stock released after this many minutes
ORDER_PAYMENT_WINDOW_MINUTES=30
